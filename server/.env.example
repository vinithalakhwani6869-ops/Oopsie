# Oopsie - API server environment
# Copy this file to server/.env and fill in real values. Never commit .env.
# The service role key bypasses RLS, so it must stay server-side only.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Any OpenAI-compatible chat completions endpoint (defaults to Groq)
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
