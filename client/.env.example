# Oopsie - web client environment
# Copy this file to client/.env and fill in real values. Never commit .env.
# Use the anon/publishable key only. Never put the service role key here.

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Leave empty to use the Vite dev proxy (/api -> http://localhost:8787)
VITE_API_URL=
